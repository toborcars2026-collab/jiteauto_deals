{
  "entities": {
    "Vehicle": {
      "title": "Vehicle",
      "description": "A vehicle listing in the inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "make": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "number" },
        "price": { "type": "number" },
        "mileage": { "type": "number" },
        "transmission": { "type": "string" },
        "fuelType": { "type": "string" },
        "bodyType": { "type": "string" },
        "location": { "type": "string" },
        "dealership": { "type": "string" },
        "images": { "type": "array" },
        "description": { "type": "string" },
        "engine": { "type": "string" },
        "color": { "type": "string" },
        "condition": { "type": "string" },
        "isFeatured": { "type": "boolean" },
        "inSlideshow": { "type": "boolean" },
        "slideshowOrder": { "type": "number" },
        "status": { "type": "string", "enum": ["Available", "Reserved", "Sold", "Hidden", "Active", "Inactive"] },
        "model3dUrl": { "type": "string" },
        "frames360": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["make", "model", "year", "price"]
    },
    "Lead": {
      "title": "Lead",
      "description": "General consultation, Find My Car, or Source A Car lead",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "vehicleType": { "type": "string" },
        "budget": { "type": "number" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "location": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "requirements": { "type": "string" },
        "type": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "sourceImage": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["New", "Contacted", "In Progress", "Completed", "Closed"] },
        "notes": { "type": "string" }
      },
      "required": ["name", "phone"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Direct vehicle acquisition or inspection inquiry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "vehicleId": { "type": "string" },
        "vehicleName": { "type": "string" },
        "budget": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "readyToBuy": { "type": "string" },
        "preferredContact": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string", "enum": ["New", "Contacted", "In Progress", "Completed", "Closed"] },
        "preferredDate": { "type": "string" },
        "preferredTime": { "type": "string" },
        "type": { "type": "string" },
        "vehiclePrice": { "type": "number" },
        "vehicleLocation": { "type": "string" }
      },
      "required": ["name", "phone", "vehicleId", "vehicleName"]
    },
    "BusinessSettings": {
      "title": "BusinessSettings",
      "description": "Centralized business profile, contact channels, and dynamic copy",
      "type": "object",
      "properties": {
        "businessName": { "type": "string" },
        "brandTagline": { "type": "string" },
        "consultantName": { "type": "string" },
        "phoneDisplay": { "type": "string" },
        "phoneCallUrl": { "type": "string" },
        "whatsAppNumber": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "instagramUrl": { "type": "string" },
        "tikTokUrl": { "type": "string" },
        "facebookUrl": { "type": "string" },
        "homepageCtaText": { "type": "string" },
        "footerText": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["businessName", "phoneDisplay", "whatsAppNumber"]
    },
    "EditorialSettings": {
      "title": "EditorialSettings",
      "description": "Automotive guides, inspection briefs, and walkaround media",
      "type": "object",
      "properties": {
        "posts": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["posts"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator registry and access control record",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "admin"] },
        "authMethods": { "type": "array" },
        "active": { "type": "boolean" },
        "inactivityTimeoutMinutes": { "type": "number" },
        "lastLoginAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "active"]
    },
    "AdminBootstrap": {
      "title": "AdminBootstrap",
      "description": "One-time administrator bootstrap completion lock record",
      "type": "object",
      "properties": {
        "setupCompleted": { "type": "boolean" },
        "setupCompletedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["setupCompleted"]
    },
    "AdminInvite": {
      "title": "AdminInvite",
      "description": "Pre-authorized administrator email invitation record",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin"] },
        "active": { "type": "boolean" },
        "invitedByUid": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "role", "active"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable administrator security and operational audit event",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["success", "failure", "warning"] },
        "details": { "type": "string" },
        "authMethod": { "type": "string" },
        "timestamp": { "type": "object", "format": "timestamp" }
      },
      "required": ["action", "actorUid", "status", "details", "timestamp"]
    }
  },
  "firestore": {
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Authoritative vehicle catalog for Jite Auto Deals"
    },
    "/leads/{leadId}": {
      "schema": { "$ref": "#/entities/Lead" },
      "description": "Customer consultation and sourcing requests"
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Direct vehicle acquisition inquiries from prospective buyers"
    },
    "/settings/business": {
      "schema": { "$ref": "#/entities/BusinessSettings" },
      "description": "Centralized business contact information and public settings"
    },
    "/settings/editorial": {
      "schema": { "$ref": "#/entities/EditorialSettings" },
      "description": "Published editorial guides and automotive walkarounds"
    },
    "/settings/admin_bootstrap": {
      "schema": { "$ref": "#/entities/AdminBootstrap" },
      "description": "Locked one-time administrator setup status"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Verified administrator role registry"
    },
    "/admin_invites/{inviteEmail}": {
      "schema": { "$ref": "#/entities/AdminInvite" },
      "description": "Pre-authorized administrator email invitations"
    },
    "/admin_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable administrator security and inventory audit trail"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Single Authorised Administrator role verification
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Administrator roles collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if false;
    }

    // Central Business Public Settings
    match /settings/business {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Central Business & Security Settings
    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Vehicles Catalog (Public read, Admin write/update/delete)
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Customer Leads (Find My Car & Source a Car: public create, admin read/update/delete)
    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Direct Vehicle Inquiries: public create, admin read/update/delete
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // System connectivity and diagnostics collection
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

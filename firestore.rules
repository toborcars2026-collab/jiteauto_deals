rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read and inventory management for vehicles catalog
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if true;
    }

    // Leads submitted by buyers and managed in Partner Console
    match /leads/{leadId} {
      allow read: if true;
      allow write: if true;
    }

    // Inquiries submitted by buyers and managed in Partner Console
    match /inquiries/{inquiryId} {
      allow read: if true;
      allow write: if true;
    }

    // Test doc for connection verification
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Central Business & Security Settings
    match /settings/{docId} {
      allow read, write, create, update, delete: if true;
    }
    
    // Vehicles Catalog (Public read, admin write/delete)
    match /vehicles/{vehicleId} {
      allow read, write, create, update, delete: if true;
    }

    // Customer Leads (Find My Car & Source a Car)
    match /leads/{leadId} {
      allow read, write, create, update, delete: if true;
    }

    // Direct Vehicle Inquiries
    match /inquiries/{inquiryId} {
      allow read, write, create, update, delete: if true;
    }

    // System connectivity and diagnostics collection
    match /test/{docId} {
      allow read, write, create, update, delete: if true;
    }

    // Fallback collection match
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

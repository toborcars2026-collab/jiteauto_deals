{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(assets|public)/:match*",
      "destination": "/$1/:match*"
    },
    {
      "source": "/(.*\\.(?:html|js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot|json|webmanifest|txt|xml))",
      "destination": "/$1"
    },
    {
      "source": "/api/resolve-image",
      "destination": "/api/resolve-image"
    },
    {
      "source": "/api/ai/consultant",
      "destination": "/api/ai-consultant"
    },
    {
      "source": "/api/admin/auth/:action*",
      "destination": "/api/admin-auth?action=:action*"
    },
    {
      "source": "/api/vehicles/:action*",
      "destination": "/api/data?resource=vehicles&action=:action*"
    },
    {
      "source": "/api/vehicles",
      "destination": "/api/data?resource=vehicles"
    },
    {
      "source": "/api/leads/:action*",
      "destination": "/api/data?resource=leads&action=:action*"
    },
    {
      "source": "/api/leads",
      "destination": "/api/data?resource=leads"
    },
    {
      "source": "/api/inquiries/:action*",
      "destination": "/api/data?resource=inquiries&action=:action*"
    },
    {
      "source": "/api/inquiries",
      "destination": "/api/data?resource=inquiries"
    },
    {
      "source": "/api/business-settings",
      "destination": "/api/data?resource=business-settings"
    },
    {
      "source": "/api/editorial-posts",
      "destination": "/api/data?resource=editorial-posts"
    },
    {
      "source": "/api/analytics/:action*",
      "destination": "/api/data?resource=analytics&action=:action*"
    },
    {
      "source": "/api/analytics",
      "destination": "/api/data?resource=analytics"
    },
    {
      "source": "/api/cloudinary-sign",
      "destination": "/api/cloudinary?action=sign"
    },
    {
      "source": "/api/cloudinary-delete",
      "destination": "/api/cloudinary?action=delete"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/vehicles/:slug*",
      "destination": "/api/render?path=/vehicles/:slug*"
    },
    {
      "source": "/car/:slug*",
      "destination": "/api/render?path=/car/:slug*"
    },
    {
      "source": "/v/:slug*",
      "destination": "/api/render?path=/v/:slug*"
    },
    {
      "source": "/(browse|inventory|catalog|cars|find-car|find-my-car|source-car|source-a-car|how-it-works|about|admin)",
      "destination": "/api/render?path=/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

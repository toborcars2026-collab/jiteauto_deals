# GEMINI_API_KEY: Required for Gemini AI API calls (if configured).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_SETUP_SECRET: Server-side high-entropy setup secret for one-time administrator provisioning.
# Set this in server/Vercel environment variables before completing initial administrator setup.
ADMIN_SETUP_SECRET=""

# ADMIN_BOOTSTRAPPED: Optional serverless environment flag ('true') to permanently lock bootstrap
# across stateless serverless invocations once initial setup is complete.
ADMIN_BOOTSTRAPPED=""

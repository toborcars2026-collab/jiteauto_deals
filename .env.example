# GEMINI_API_KEY: Required for Gemini AI API calls (if configured).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL / ADMIN_PASSWORD: Optional server-side administrator credentials (decoupled from Firestore).
# Set these in server/Vercel environment variables for stateless hosting, or leave blank to claim via first-time setup.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ADMIN_SETUP_SECRET: Optional high-entropy secret to guard first-time setup or credential reset.
ADMIN_SETUP_SECRET=""

# ADMIN_BOOTSTRAPPED: Optional environment flag ('true') for external bootstrap locking.
ADMIN_BOOTSTRAPPED=""

# CLOUDINARY_*: Server-side Cloudinary configuration for signed direct vehicle image uploads & lifecycle cleanup.
# Obtain these from Cloudinary Console -> Settings -> API Keys. Never commit secrets to GitHub.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional signed upload preset name (leave blank to use signed direct folder uploads automatically).
CLOUDINARY_UPLOAD_PRESET=""

